    {
      "name": "1. Required APIs",
      "item": [
        {
          "name": "Create or get chat",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/chat/create",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat",
                "create"
              ]
            },
            "description": "1:1 chat. The same two users always get the same chatId back.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userAId\": \"{{userA}}\",\n  \"userBId\": \"{{userB}}\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 on create, 200 when it already exists', () => pm.expect([200, 201]).to.include(pm.response.code));",
                  "pm.collectionVariables.set('chatId', pm.response.json().chatId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Send message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/chat/{{chatId}}/message/send",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat",
                "{{chatId}}",
                "message",
                "send"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"senderId\": \"{{userA}}\",\n  \"text\": \"Hi Vikram, did you see the new build?\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('messageId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Send reply",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
