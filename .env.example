PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/chat

# Firestore. for local work start the emulator with `npm run emulator` and keep these:
FIREBASE_PROJECT_ID=demo-chat
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# for a real Firebase project: remove FIRESTORE_EMULATOR_HOST, set your project id
# and point this at the service account json downloaded from the Firebase console
# FIREBASE_SERVICE_ACCOUNT=./serviceAccount.json
