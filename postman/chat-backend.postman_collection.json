      "value": ""
    },
    {
      "key": "userB",
      "value": ""
    },
    {
      "key": "userC",
      "value": ""
    },
    {
      "key": "chatId",
      "value": ""
    },
    {
      "key": "messageId",
      "value": ""
    },
    {
      "key": "groupId",
      "value": ""
    }
