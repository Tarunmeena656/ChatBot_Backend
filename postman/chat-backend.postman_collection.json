          "name": "Get messages",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/chat/{{chatId}}/messages?limit=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat",
                "{{chatId}}",
                "messages?limit=50"
